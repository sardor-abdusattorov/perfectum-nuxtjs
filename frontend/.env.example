# Браузер ходит только на этот сайт: запросы со страницы идут на /api/v1 и
# проксируются на бэкенд сервером Nuxt. Адрес самого бэкенда знает только
# сервер, поэтому API можно не выставлять наружу вовсе.
NUXT_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000

VITE_USE_POLLING=false

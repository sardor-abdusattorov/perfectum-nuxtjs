# Один адрес на браузер и на SSR. NUXT_API_BASE нужен, только если сервер
# ходит в API по другому адресу (например, по имени контейнера).
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000

VITE_USE_POLLING=false

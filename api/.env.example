APP_NAME=Perfectum
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Единственный origin, которому браузер разрешит обращаться к API.
# Запрос с чужого сайта получит отказ CORS. Несколько адресов — через запятую.
# На проде: FRONTEND_URL=https://perfectum.uz
FRONTEND_URL=http://localhost:3000

# Адрес, с которого приходит прокси Nuxt: без него в лимитах и в счётчике
# просмотров окажется его IP, а не адрес посетителя. Фронт стоит на той же
# машине, поэтому доверяем только ей — не «*».
TRUSTED_PROXIES=127.0.0.1

APP_URL=http://localhost:8000
PHP_CLI_SERVER_WORKERS=8

# Как даты хранятся. На работающей базе не переключать: строки, записанные
# при UTC, начнут читаться как ташкентские и станут на 5 часов раньше —
# 3589 заявок и все новости разом. Для этого есть APP_DISPLAY_TIMEZONE.
APP_TIMEZONE=UTC

# Как даты показываются в админке. Работает независимо от хранения, поэтому
# на живой базе меняют именно её.
APP_DISPLAY_TIMEZONE=Asia/Tashkent

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perfectum
DB_USERNAME=perfectum
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BILLING_API_URL=https://api-dmz.perfectum.uz/api/bss/v1
BILLING_API_TOKEN=

CDMA_API_URL=http://pk.cdma.uz
